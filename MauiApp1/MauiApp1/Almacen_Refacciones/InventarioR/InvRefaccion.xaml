<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="iAlmacen.Almacen_Refacciones.InventarioR.InvRefaccion"
             Title="Inventario Refacciones"
             SafeAreaEdges="None">
    <ContentPage.Content>
        <Grid SafeAreaEdges="None">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <ImageButton Source="ImagenFull/PlantillaM.jpg" Aspect="AspectFill" Clicked="CrearPlantillaNueva" />
            <Label Margin="0,0,10,0" HorizontalTextAlignment="End" Text="Crear Plantilla" TextColor="White" FontSize="35" FontAttributes="Bold" VerticalOptions="End" />

            <ImageButton Grid.Row="1" Source="ImagenFull/CapturaM.jpg" Aspect="AspectFill" Clicked="Capturar_Clicked" />
            <Label Margin="0,0,10,0" HorizontalTextAlignment="End" Grid.Row="1" Text="Capturar Inventario" TextColor="White" FontSize="35" FontAttributes="Bold" VerticalOptions="End" />

            <ImageButton Grid.Row="2" Source="ImagenFull/ValidarM.jpg" Aspect="AspectFill" Clicked="AplicarInvetarios_Clicked" />
            <Label Margin="0,0,10,0" HorizontalTextAlignment="End" Grid.Row="2" Text="Aplicar Inventario" TextColor="White" FontSize="35" FontAttributes="Bold" VerticalOptions="End" />
        </Grid>
    </ContentPage.Content>
</ContentPage>